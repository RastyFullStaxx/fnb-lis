# Server (database path is configured in prisma.config.ts / src/db.ts: data/fnb.db)
PORT=3001

# Anthropic API — enables PDF/image import extraction and Stocky (Phases 6 & 8).
# Leave empty to run without AI features (CSV/XLSX imports still work).
ANTHROPIC_API_KEY=

# ── Security (docs/security.md) ──────────────────────────────────────────────

# Believe X-Forwarded-For / X-Forwarded-Proto. Set to 1 ONLY when a reverse
# proxy you control sits in front AND it OVERWRITES those headers rather than
# appending — e.g. Caddy's `header_up X-Forwarded-For {remote_host}`.
#
# Off by default on purpose: those are ordinary request headers, so anything on
# the network can set them. Every login and mutation records an IP in the
# activity trail, and a forged IP in an audit record is worse than no IP at all
# because it reads as evidence. See docs/security.md M-1.
FNB_TRUST_PROXY=

# Per-IP rate limits (docs/security.md H-2). Defaults are in app.ts.
# FNB_RATE_LIMIT_LOGIN — FAILED sign-ins per 15 min (default 10). Counting
#   failures, not attempts, means a shift change behind one NAT address never
#   trips it while a password guesser trips it in seconds.
# FNB_RATE_LIMIT_API — requests per minute across /api/* (default 1200). One
#   dashboard load is ~20 calls, so this is a flood ceiling, not a usage budget.
FNB_RATE_LIMIT_LOGIN=
FNB_RATE_LIMIT_API=

# Per-request ceiling in ms (default 120000). A resource guard, not a latency
# budget — AI import extraction legitimately runs tens of seconds. The Stocky
# SSE stream is excluded in app.ts and must stay excluded.
FNB_REQUEST_TIMEOUT_MS=

# Set to 0 to disable the breached-password check on user create/reset.
# The candidate password NEVER leaves the process (k-anonymity: only the first
# 5 chars of its SHA-1 are sent), and the check already fails OPEN if the API is
# unreachable — so this only needs setting on a deliberately offline deploy.
FNB_BREACH_CHECK=

# Error reporting. No DSN → lib/telemetry.ts is a no-op and the SDK never loads.
# Sends the error object only, never request bodies (they carry inventory data).
SENTRY_DSN=

# ── Two-factor authentication (docs/security-mfa.md §1) ──────────────────────

# 32 bytes, base64 — AES-256-GCM key for the stored TOTP secrets.
#
# SETTING THIS IS WHAT TURNS MFA ON. Without it the secrets could not be
# encrypted, so the whole feature stays off rather than half-on — and enforcing
# "ADMIN must enrol" while enrolment is impossible would brick the administrator
# account with no way back in.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# LOSING THIS LOCKS OUT EVERY ENROLLED USER. Back it up separately from the
# database — storing both together defeats the point.
FNB_MFA_KEY=

# Set to 0 to keep enrolment available but stop ENFORCING it for ADMIN/OWNER.
# For a staged rollout; leave unset in production.
FNB_REQUIRE_MFA=
