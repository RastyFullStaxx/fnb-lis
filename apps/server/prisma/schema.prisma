// ───────────────────────── Imports ─────────────────────────

model ImportBatch {
  id             String    @id @default(cuid())
  locationId     String
  location       Location  @relation(fields: [locationId], references: [id])
  kind           String // SALES | PURCHASES | NON_REVENUE | COUNTS
  fileName       String
  fileSha256     String
  storedPath     String
  sourceType     String // CSV | XLSX | PDF | IMAGE
  extractor      String // DETERMINISTIC | AI
  model          String? // AI model id when extractor = AI
  rawExtractJson String? // raw extraction payload (TEXT)
  status         String    @default("PROCESSING") // PROCESSING | NEEDS_REVIEW | COMMITTED | REVERSED | FAILED
  businessDate   String?
  createdById    String
  createdByName  String
  createdAt      DateTime  @default(now())
  committedAt    DateTime?
  committedById  String?
  reversedAt     DateTime?
  reversedById   String?

  rows ImportRow[]

  @@index([locationId])
}

model ImportRow {
  id                    String      @id @default(cuid())
  batchId               String
  batch                 ImportBatch @relation(fields: [batchId], references: [id])
  rowIndex              Int
  rawJson               String // original row payload (TEXT)
  itemText              String
  qty                   Float?
  unitCost              Float?
  unitPrice             Float?
  rowDate               String?
  matchedLocationItemId String?
  matchedMenuItemId     String?
  matchMethod           String? // EXACT | ALIAS | FUZZY | MANUAL
  confidence            Float?
  warning               String?
  status                String      @default("PENDING") // PENDING | APPROVED | REJECTED | COMMITTED
  resultType            String? // SALE | PURCHASE_LINE — enables precise batch reversal
  resultId              String?

  @@index([batchId])
}

// ───────────────────────── System ─────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  ts          DateTime @default(now())
  userId      String?
  userName    String? // denormalized for display; audit records freeze the actor's name
  clientId    String?
  locationId  String?
  action      String // e.g. auth.login, purchase.commit, locationItem.priceChange
  entity      String
  entityId    String?
  summary     String
  detailsJson String? // old/new values (TEXT)

  /**
   * Tamper-evidence for the audit trail (docs/security.md).
   *
   * `hash` = SHA-256 over this row's own material fields PLUS the previous
   * row's hash, so the log is a chain: altering, deleting or reordering any row
   * breaks every hash after it. `seq` is the chain position — a monotonic
   * integer, so a verifier can walk in a defined order without depending on
   * timestamp ties.
   *
   * This is the difference between a system that STORES its history and one
   * that can PROVE the history was not edited — including by whoever holds the
   * database file, which is precisely this product's stated adversary. Storing
   * a log an insider can quietly rewrite is a confident lie.
   *
   * Nullable because rows written before this shipped have no chain; the
   * verifier reports where the chain begins rather than treating history as
   * corrupt.
   */
  seq      Int?    @unique
  prevHash String?
  hash     String?
  // ts = when the server logged it; occurredAt = when the user did it on an
  // offline device. Same distinction as CountSession.occurredAt, and the reason
  // the audit trail of a synced day is still readable as a sequence of events.
  occurredAt  DateTime?
  // Which desktop the action came from, null for the browser. An admin
  // investigating a discrepancy needs to know it arrived from the bar PC.
  deviceId    String?

  @@index([ts])
  @@index([entity, entityId])
}

/**
 * Applied sync operations — the ONE genuine idempotency-token table here, and
 * worth explaining because everything else deliberately avoids being one.
 *
 * For a CREATE, the record's own primary key answers "did this already apply?"
 * for free (see `syncFields` in @fnb/core), so no token is needed. A VOID or a
 * COMMIT is not a new row: there is no key to collide, and a replayed void is
 * therefore indistinguishable from someone ELSE having voided the same record
 * in the browser meanwhile. Those two cases need opposite handling — one is a
 * success, the other is a conflict a human must see — so the distinction cannot
 * be guessed. `opId` is the client-minted key that makes it decidable.
 *
 * Written in the SAME transaction as the mutation it records, or a crash between
 * the two would let the operation apply twice.
 *
 * Unlike every other table in this schema, this one is pruned: an operation is
 * never replayed once its device has synced past it. See
 * docs/sync-and-data-lifecycle.md §7.6 — 90 days.
 */
model SyncOp {
  opId       String   @id
  userId     String
  deviceId   String?
  entity     String // CountSession | SaleRecord | ...
  entityId   String
  action     String // commit | void | correct
  appliedAt  DateTime @default(now())

  @@index([appliedAt])
  @@index([entity, entityId])
}

model Setting {
  id       String @id @default(cuid())
  clientId String @default("") // "" = global
  key      String
  value    String // JSON text

  @@unique([clientId, key])
}
