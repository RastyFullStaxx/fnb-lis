// FNB/LIS — full domain schema (all models land day one; migrations stay additive).
//
// Portability rules (see docs/architecture.md §2 — do not violate):
//  - No enums: "enum" fields are String, validated by zod in @fnb/core.
//  - No Json scalar: JSON payloads are String (TEXT), parsed by zod at the boundary.
//  - Float, not Decimal: legacy parity with PHP doubles; rounding via core phpRound only.
//  - Business dates are String 'YYYY-MM-DD'; DateTime is for timestamps only.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ───────────────────────── Identity & tenancy ─────────────────────────

model User {
  id               String    @id @default(cuid())
  username         String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  email            String?
  role             String // ADMIN | MANAGER | STAFF | ACCOUNTANT | READONLY
  status           String    @default("ACTIVE") // ACTIVE | DISABLED
  failedLoginCount Int       @default(0)
  failedLoginAt    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions            AuthSession[]
  clientAccess        UserClientAccess[]
  modules             UserModule[]
  devicePin           DevicePin?
  mfa                 UserMfa?
  mfaChallenges       MfaChallenge[]
  itemUnitPreferences UserItemUnitPreference[]
}

/**
 * How a person signs in on the offline desktop when there is no network to ask.
 *
 * A SEPARATE credential from the password, and that separation is the whole
 * point. The obvious design — ship `User.passwordHash` to the device and verify
 * it locally — turns the theft of one bar PC into remote compromise of the web
 * application, because the cracked secret is the same secret. A PIN is accepted
 * ONLY by a registered desktop and never by the server, so the same theft yields
 * something that unlocks a machine the thief already physically holds.
 *
 * Be clear about what this does and does not do. Four to eight digits will not
 * survive an offline attack on the file, and it is not meant to: whoever holds
 * the machine holds the mirror, and encryption at rest is the answer to that,
 * not a longer PIN. What the PIN buys is (a) casual-access control at the bar,
 * (b) attribution — which member of staff recorded this count — and (c) a blast
 * radius that stops at one revocable device.
 *
 * Failure counts and lockouts are deliberately NOT here: they are device-local
 * state, since a device that cannot reach the server cannot increment a counter
 * on it. The device tracks them in its own mirror and pushes an ActivityLog row
 * on the next sync.
 */
model DevicePin {
  userId String @id
  user   User   @relation(fields: [userId], references: [id])
  // Same scrypt format as passwordHash (auth/password.ts).
  pinHash String
  /**
   * Break-glass for "no network, forgot the PIN, and the closing count still has
   * to happen". Free text the user writes themselves rather than a canned list —
   * "mother's maiden name" is the weakest link in every design that ships one.
   * The answer is normalised then hashed, never stored readable.
   */
  recoveryQuestion   String
  recoveryAnswerHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * Second factor for the web login (TOTP — Google Authenticator, Authy, 1Password).
 *
 * Required for ADMIN and OWNER, optional for everyone else (client decision
 * 2026-08-01). STAFF are deliberately excluded from the requirement: they sign
 * in on a shared bar PC mid-shift, already hold a device PIN, and are already
 * restricted to appends — a second factor buys little there at real cost to a
 * counting workflow.
 *
 * Absence of a row means "not enrolled", so existing accounts need no backfill.
 *
 * This protects the BROWSER login only. The offline desktop is unaffected by
 * design: it authenticates a machine, its PIN check happens locally with no
 * network, and demanding a phone code from a bar PC that may have no signal
 * would break the one thing the desktop exists to do.
 */
model UserMfa {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /**
   * AES-256-GCM ciphertext of the base32 TOTP secret, as iv:tag:ciphertext hex.
   * ENCRYPTED, not hashed — verification needs the plaintext back — under a key
   * (FNB_MFA_KEY) that lives outside the database, so a leaked database file
   * alone yields no working second factors.
   */
  secretEnc String
  /**
   * Null until the user proves one working code. Enrolment that stopped at the
   * QR screen must not count as enrolled, or a mis-scan locks someone out of
   * their own account with no way back in.
   */
  confirmedAt DateTime?
  /**
   * Newline-separated scrypt hashes of single-use recovery codes (same format
   * as passwordHash). Hashed rather than encrypted because these are only ever
   * compared, never displayed again after enrolment.
   */
  backupCodes String
  /**
   * The last 30-second step accepted for this user, so a code cannot be spent
   * twice (RFC 6238 §5.2).
   *
   * Without it, `window = 1` leaves one 6-digit code valid for ~90 seconds —
   * long enough for anyone who watched it being typed, or captured it in
   * transit, to replay it. Storing the step rather than the code keeps nothing
   * secret on disk: it is just a monotonically increasing integer.
   */
  lastTotpStep Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/**
 * The gap between "password accepted" and "second factor accepted".
 *
 * A row here is NOT a session and cannot be mistaken for one — that is why it
 * is a separate table rather than a flag on AuthSession. A half-authenticated
 * row living in the session table would need every reader to remember to check
 * the flag, and forgetting once fails OPEN. Nothing issues a session cookie
 * until the second factor lands.
 *
 * The device payload and rememberMe ride along because step two is what
 * actually completes the login: resolving a device in step one would register
 * a machine (consuming a licence slot) for someone who has only proved half
 * their credentials.
 */
model MfaChallenge {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  rememberMe Boolean @default(true)
  /// The DeviceLogin payload as JSON text (no Json scalar — SQLite portability).
  deviceJson String?
  ip         String?
  userAgent  String?
}

// Per-user module restriction (client req #9): which of BAR/KITCHEN/ASSET
// this user may work in. NO rows = unrestricted (backward compatible, and
// what most staff get); ADMIN always bypasses. Enforced in one choke point —
// requireLocationAccess intersects these with the location's own modules.
model UserModule {
  userId String
  user   User   @relation(fields: [userId], references: [id])
  module String // BAR | KITCHEN | ASSET

  @@id([userId, module])
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?
  // Set when this session belongs to a registered offline desktop rather than
  // a browser. Device sessions get a far longer, NON-sliding TTL: a mirror can
  // be off the network for weeks, and the 7-day sliding browser session would
  // lock the establishment out of its own till. Revocation is via Device.status,
  // which is checked on every use — so a long TTL is not an unrevokable one.
  deviceId  String?
  device    Device?  @relation(fields: [deviceId], references: [id])

  @@index([userId])
  @@index([deviceId])
}

// ─────────────────── Offline desktop (local mirror) ───────────────────
// Proposal §18: the desktop is the "sole operational interface" on "one (1)
// client computer". That single-writer guarantee is what makes a local mirror
// tractable — see docs/sync-and-data-lifecycle.md. A Device is the identity
// that guarantee is enforced against: registration is what binds a licence to
// a machine (§20), and revoking one kills its sessions without touching the
// human accounts that used it.
model Device {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])
  // The mirror's home location. Null means the desktop has not been pointed at
  // one yet (registered but not provisioned) — it can authenticate but has
  // nothing to pull.
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])
  name         String // "Front bar PC" — what the LIS admin sees in the device list
  // Machine identifier the desktop reports at registration. Unique across the
  // install so one physical computer cannot hold two licences.
  fingerprint  String    @unique
  status       String    @default("ACTIVE") // ACTIVE | REVOKED
  registeredAt DateTime  @default(now())
  lastSeenAt   DateTime?
  // Last successful push. The gap between this and now() is the "how much work
  // is stranded on that machine" number an admin needs when a device goes dark.
  lastSyncAt   DateTime?

  sessions AuthSession[]

  @@index([clientId])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("ACTIVE") // ACTIVE | ARCHIVED
  // Inventory cost basis for VALUATION reports (see @fnb/core COST_BASES).
  // PRICE = count-line snapshot cost (default, matches everything shipped so
  // far); AVERAGE = periodic weighted average. Never affects variance.
  costBasis String   @default("PRICE") // PRICE | AVERAGE
  // Over/short materiality threshold (%) for the Full Audit highlight — an
  // audit policy, so it is per-establishment (client req 2026-07-21). Default
  // 11 = @fnb/core MATERIAL_VARIANCE_PCT. Presentation only; never touches the
  // reconciliation math.
  varianceThresholdPct Float @default(11)
  // Whether this establishment may SEE bottle tare / liquid weights (client
  // decision 2026-07-25). Off by default: that calibration library is LIS's
  // own IP, shown to a client only when the LIS admin turns it on for them.
  // Client req 2026-07-28: the LIS admin can let an establishment VIEW reports
  // while withholding downloads — used for audit-service clients and as leverage
  // separate from the billing lockout. Default on; only ADMIN can change it.
  allowReportDownloads Boolean @default(true)

  // Superseded 2026-07-25: clients weigh their own bottles into LocationItem
  // overrides and always see them. Column kept — migrations stay additive.
  showBottleWeights Boolean @default(false)
  createdAt DateTime @default(now())

  locations    Location[]
  access       UserClientAccess[]
  suppliers    Supplier[]
  aliases      ItemAlias[]
  subscription Subscription?
  devices      Device[]
  itemUnitDefaults ClientItemUnitDefault[]
}

model Location {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  name      String
  // ponytail: kind is a LABEL for grouping/pickers (main bar vs satellites vs
  // stockroom, client req #13) — no behavior branches on it. Null = unlabeled.
  kind      String? // MAIN | SATELLITE | STOCKROOM
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  modules       LocationModule[]
  locationItems LocationItem[]
  countSessions CountSession[]
  purchases     Purchase[]
  sales         SaleRecord[]
  forfeits      Forfeit[]
  menuItems     MenuItem[]
  importBatches ImportBatch[]
  transfersOut  Transfer[]       @relation("TransferFrom")
  transfersIn   Transfer[]       @relation("TransferTo")
  devices       Device[]
  areas         LocationArea[]
  bottleKeeps   BottleKeep[]

  @@index([clientId])
}

/// Where inside the establishment stock physically sits.
///
/// Straight off the client's own paper sheet (June 2026): every item row has a
/// column per area — MAIN BAR, COCKTAIL LOUNGE, BEER HALL, STOCK ROOM — tallied
/// separately, and the number in the margin is their sum. Collapsing that to one
/// figure loses the only thing that makes a variance actionable: WHICH shelf to
/// recount.
///
/// Optional throughout. A location that does not split its stock never sees an
/// area and every line carries null, which is exactly how every existing count
/// already looks.
/// A bottle a customer paid for and left behind to finish next visit.
///
/// **One row per bottle, never a quantity.** This is the client's own stated
/// challenge (2026-08-04): "what if may 10 bottles Jack Daniel's na different or
/// same date ang entry for Bottle Keeps but different name of client guest".
/// Ten bottles under ten guests are ten rows — a `qty: 10` row could not say
/// whose is whose, when each expires, or which one was claimed on Tuesday.
///
/// Why it is not just a Forfeit yet: the bottle is physically on the shelf but
/// **is not the bar's to sell**. Counting it as stock would show a surplus now
/// and a shortage the day the guest comes back and drinks it with no sale
/// behind it — the variance noise that stops people trusting the Full Audit.
/// It becomes stock only on expiry, through the existing zero-cost Forfeit.
model BottleKeep {
  id               String        @id @default(cuid())
  locationId       String
  location         Location      @relation(fields: [locationId], references: [id])
  /// Where the bottle physically sits — the client asked for exactly this
  /// ("Main Bar or Satellite bar 1"), and it is the same shelf list counts
  /// already use, so no second vocabulary.
  areaId           String?
  area             LocationArea? @relation(fields: [areaId], references: [id])
  locationItemId   String
  locationItem     LocationItem  @relation(fields: [locationItemId], references: [id])

  /// Whose bottle it is. Free text on purpose: bars know guests by name, not by
  /// an account, and demanding a customer record would stop the bartender
  /// recording it at all.
  customerName     String
  customerContact  String?

  qty              Float         @default(1)
  /// Partial bottles come back on keep too — a guest leaves half a bottle.
  remainingContent Float         @default(0)

  keptDate         String // YYYY-MM-DD
  /// Stored as a DATE, not "days from kept".
  ///
  /// A day count would be re-evaluated against whatever the default is today,
  /// so changing the house policy from 30 to 60 days would silently move the
  /// expiry of every bottle already on the shelf — including ones already past
  /// it. The date this bottle was promised is a fact about that bottle.
  expiresOn        String // YYYY-MM-DD

  status           String        @default("ACTIVE") // ACTIVE | CLAIMED | FORFEITED | VOID
  claimedAt        DateTime?
  claimedById      String?
  forfeitedAt      DateTime?
  /// The zero-cost stock-in created when it expired, so the report can show
  /// where the bottle went and the two can never disagree.
  forfeitId        String?       @unique
  forfeit          Forfeit?      @relation(fields: [forfeitId], references: [id])

  note             String?
  voidReason       String?
  createdById      String
  createdByName    String
  createdAt        DateTime      @default(now())

  @@index([locationId, status, expiresOn])
  @@index([locationId, customerName])
}

model LocationArea {
  id         String     @id @default(cuid())
  locationId String
  location   Location   @relation(fields: [locationId], references: [id])
  name       String
  /// Print/display order — the paper sheet has a fixed column order and the
  /// screen must match it, or checking one against the other is guesswork.
  sortOrder  Int        @default(0)
  status     String     @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt  DateTime   @default(now())

  countLines  CountLine[]
  bottleKeeps BottleKeep[]

  @@unique([locationId, name])
  @@index([locationId])
}

// The enforced reality for a single location: which modules it may stock,
// per the Fix Plan §2.3 design principle. Must be a subset of that location's
// client's SubscriptionModule set (the ceiling) — validated in application
// code at write time (see routes/admin.ts locationModulesBody), not by the
// database, since Prisma/SQLite can't express a cross-table subset constraint.
model LocationModule {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  module     String // BAR | KITCHEN | ASSET

  @@unique([locationId, module])
}

model UserClientAccess {
  userId   String
  clientId String
  user     User   @relation(fields: [userId], references: [id])
  client   Client @relation(fields: [clientId], references: [id])

  @@id([userId, clientId])
}

// ───────────────────────── Subscription & Packages ─────────────────────────
// packageType: BASIC | MEDIUM | FULL | ONE_TIME — DERIVED, not independently settable.
//   Computed server-side from (billingCycle, maxEntities, maxUsers) via
//   derivePackageType() in @fnb/core on every create/update (see admin.ts).
//   It used to be a separately-settable field and could drift from the truth
//   (e.g. badged "Basic" while actually unlimited) — that's fixed now; it's
//   stored (not computed on read) purely so it can be queried/filtered
//   without joining, but the column always mirrors billingCycle+maxEntities+maxUsers.
// billingCycle: STANDALONE | MONTHLY — directly settable; drives packageType above.
// modules: SubscriptionModule rows, one per atomic module (BAR | KITCHEN | ASSET)
//   the client is licensed for in total — the *ceiling* every location's own
//   LocationModule set must stay within (Fix Plan Phase C §2.3/§2.2).
// maxEntities: admin-set number of locations; 0 = unlimited. No longer what
//   names the tier (see maxUsers below, client req 2026-07-21) — it still
//   gates location creation (POST /clients/:id/locations) on its own.
// maxUsers: admin-set number of USER accounts (client req 2026-07-21) — THIS
//   is what names the Monthly tier now (Basic 1 / Medium 2-5 / Full 6-10).
//   0 = no cap saved (legacy rows, pre-dates this field — derivePackageType
//   falls back to maxEntities for these so they keep their existing badge).
//   Standalone owners set their own number so accounts can't be generated
//   without their knowledge — never unlimited by default there either.
//   Enforced in assertUserSeatsAvailable (admin.ts), called from both
//   POST /users and PUT /users/:id/access.
// negotiatedPrice: optional per-client/per-deal price, if tracked in-system at
//   all — set directly on the subscription, not sourced from any catalog.
//
// paid / lastPaidAt — explicit payment tracking (never assumed true on creation):
//   paid = true means the admin has confirmed payment for the current billing period.
//   lastPaidAt = the timestamp of the most recent "Mark as paid" click.
//   For MONTHLY plans, effective access state is computed on read (compute-on-load, no
//   background job) — see admin.ts deriveAccessState().

model Subscription {
  id              String    @id @default(cuid())
  clientId        String    @unique
  client          Client    @relation(fields: [clientId], references: [id])
  packageType     String // BASIC | MEDIUM | FULL | ONE_TIME — derived, see note above
  billingCycle    String // STANDALONE | MONTHLY
  maxEntities     Int       @default(1) // admin-set location count; 0 = unlimited. Gates location creation, no longer names the tier.
  // Max USER accounts this client may have (client req 2026-07-21). Monthly
  // tiers cap it (Basic 1 / Medium 5 / Full 10); Standalone owners set their
  // own number so nobody can quietly generate logins. 0 = unlimited (legacy).
  maxUsers        Int       @default(0)
  // Max registered offline desktops. Proposal §18 sells the desktop as running
  // on "one (1) client computer", and §20 binds the licence to it — so this is
  // the licence, expressed as a number the admin can raise per deal. 0 =
  // unlimited. Enforced at registration, not at sync: a device that is already
  // registered keeps working even if the cap is later lowered, because the
  // alternative is stranding a night's counts on a machine that can't push.
  maxDevices      Int       @default(1)
  negotiatedPrice Float? // optional per-client deal price — see note above
  status          String    @default("ACTIVE") // ACTIVE | SUSPENDED | CANCELLED | TRIAL
  paid            Boolean   @default(false) // explicit paid flag for the CURRENT billing period
  lastPaidAt      DateTime? // null until first "Mark as paid"; updated on every mark-paid click
  startDate       String // YYYY-MM-DD
  endDate         String? // null = no expiry (ONE_TIME / perpetual)
  note            String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  cancelledAt     DateTime?
  cancelledById   String?

  modules SubscriptionModule[]
  reports SubscriptionReport[]
}

// The ceiling: every atomic module (BAR | KITCHEN | ASSET) this client is
// licensed for across every location they operate (Fix Plan §2.2/§2.3).
model SubscriptionModule {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  module         String // BAR | KITCHEN | ASSET

  @@unique([subscriptionId, module])
}

// Which report slugs (`apps/web/src/pages/reports/index.tsx` `path` values)
// this client's subscription may open — client req #3 (2026-08-02 brief), see
// docs/2026-08-04-report-tier-gating-plan.md. Same shape as SubscriptionModule:
// one row per enabled report, seeded from a tier preset at subscription
// creation and hand-editable per client after (decision in the plan doc —
// gate on this explicit set, not on the derived packageType label).
model SubscriptionReport {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  reportSlug     String

  @@unique([subscriptionId, reportSlug])
}

// ───────────────────────── Master data (global) ─────────────────────────

model Unit {
  id           String  @id @default(cuid())
  name         String  @unique
  kind         String // VOLUME | MASS | COUNT (base: ml | g | 1)
  factorToBase Float
  isSystem     Boolean @default(false)

  variants ItemVariant[]
}

model Category {
  id                   String @id @default(cuid())
  name                 String @unique
  productType          String // data-driven list in Setting "productTypes"
  defaultDensityFactor Float? // ml per weight-unit for weigh counts (e.g. Vodka 30.12/oz)
  sortOrder            Int    @default(0)
  // Asset-only, nullable (client req 2026-07-24). Set once per category
  // (e.g. "Dental Equipment" -> Dental) rather than per LocationItem —
  // every asset in a category shares one industry/vertical by design.
  // data-driven list, Setting "industryOptions".
  industry             String?

  items Item[]
}

model Item {
  id          String   @id @default(cuid())
  name        String
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  description String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants ItemVariant[]
  unitDefaults    ClientItemUnitDefault[]
  unitPreferences UserItemUnitPreference[]

  @@index([categoryId])
}

model ItemVariant {
  id             String  @id @default(cuid())
  itemId         String
  item           Item    @relation(fields: [itemId], references: [id])
  size           Float // e.g. 700 (ml), 1 (kg), 1 (pack)
  unitId         String
  unit           Unit    @relation(fields: [unitId], references: [id])
  contentTracked Boolean @default(false) // true: open amounts divide by size (bottles); false: raw counts
  // How this variant is weighed on a scale (client req #16):
  //   null    → legacy inference: contentTracked ⇒ DENSITY, else not weighable
  //   DENSITY → (scale − tare) × densityFactor ⇒ content in ml (bar bottles;
  //             also Food items sold by liquid content)
  //   NET     → (scale − tare) converted to the variant's unit ⇒ quantity
  //             directly (kitchen: net weight IS the count; MASS units only)
  weighMode      String? // DENSITY | NET
  tareWeight     Float?
  tareWeightUnit String? // g | oz
  densityFactor  Float? // per-item override of Category.defaultDensityFactor
  barcode        String?
  // An open "this weight looks wrong" report from a client (client req
  // 2026-07-25). Clients cannot edit the weight library, so this is how they
  // ask: a note raised by their owner/manager, cleared by the LIS admin when
  // he has re-weighed. Non-null note = a review is pending — derived, so there
  // is no request lifecycle to keep in sync, and only one open ask per bottle.
  weightReviewNote String?
  weightReviewBy   String?
  weightReviewAt   DateTime?

  // Asset-only, nullable (architecture.md deviation #26) — intrinsic to the
  // product line, so these live here rather than on LocationItem. Ignored by
  // Bar/Kitchen/Supplies rows, same treatment as weighMode above for non-Bar items.
  brand          String?
  model          String?
  isActive       Boolean @default(true)

  locationItems LocationItem[]

  @@unique([itemId, size, unitId])
}

// ───────────────────────── Per-location catalog ─────────────────────────

model LocationItem {
  id            String      @id @default(cuid())
  locationId    String
  location      Location    @relation(fields: [locationId], references: [id])
  itemVariantId String
  itemVariant   ItemVariant @relation(fields: [itemVariantId], references: [id])
  cost          Float       @default(0)
  retail        Float       @default(0)
  parLevel      Float?
  // Per-location bottle weights (client decision 2026-07-25: "sila na mag
  // timbang… dapat din makita nila. Since Local Database lang naman ang
  // nakikita ni User at hindi whole Main Database").
  //
  // ItemVariant is GLOBAL — every client draws from the same master catalog —
  // so a client editing the variant would silently rewrite other tenants'
  // numbers. They weigh their own bottles into their own catalog row instead;
  // the master stays LIS's. Null = fall back to the variant, then the category
  // default. Same product can legitimately differ by venue (supplier batch).
  tareWeight     Float?
  tareWeightUnit String? // g | oz
  densityFactor  Float?

  // Asset-only, nullable (architecture.md deviation #26). assetCode is the
  // human-readable AST-### register number: unique when set, sequential across
  // the whole client, not per-category (see asset-module-proposal.md). `cost`
  // above doubles as "current cost"; initialCost is the fixed purchase price.
  assetCode     String?     @unique
  initialCost   Float?
  serialNo      String?     // per asset TYPE not per unit — see asset-module-proposal.md
  condition     String?     // data-driven list, Setting "conditionOptions"
  status        String?     // data-driven list, Setting "statusOptions" — distinct from isActive
  remarks       String?
  isActive      Boolean     @default(true)
  // Expected movement window (1-12, calendar month), clutter-item-removal
  // plan. Null on both = no schedule, plain 12-month lookback applies.
  // Outside the window, no movement is normal and the item is skipped as a
  // candidate; inside it, no movement is a real signal.
  scheduleStartMonth Int?
  scheduleEndMonth   Int?
  updatedById   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  countLines       CountLine[]
  purchaseLines    PurchaseLine[]
  sales            SaleRecord[]
  forfeits         Forfeit[]
  recipeLines      RecipeLine[]
  aliases          ItemAlias[]
  transferLines    TransferLine[]
  transferReceipts TransferReceiptLine[]

  @@unique([locationId, itemVariantId])
  bottleKeeps      BottleKeep[]
}

// Per-item display unit — admin default (client req 2026-07-31, see
// docs/per-user-per-item-uom-plan.md). Presentation only, same as
// preferredVolumeUnit/preferredMassUnit in Setting(prefs:<userId>) — storage
// unit is still ItemVariant.unitId and nothing here feeds convert()/toBase().
//
// A manager sets one row per item; it applies to every user of that client
// who has not set their own UserItemUnitPreference for the same item
// (resolveDisplayUnit() in @fnb/core walks both). Scoped by clientId, not
// locationId: the item's catalog identity is global but the "how do WE like
// to see it" call is an establishment policy, same tier as Client.costBasis
// and Client.varianceThresholdPct — hence master.write gating, not per-location.
//
// Server-only, one-way (server -> device, overwrite) — same sync
// classification as LocationItem and pricing (sync-and-data-lifecycle.md §2,
// §7.2 rule 3): a display default is "set at a desk", not a device-local write.
model ClientItemUnitDefault {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  unit        String // one of PREFERENCE_UNITS in packages/core/src/units.ts
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([clientId, itemId])
}

// Per-item display unit — staff's own override (client req 2026-07-31, see
// docs/per-user-per-item-uom-plan.md). Sits above ClientItemUnitDefault in
// resolveDisplayUnit()'s order: a staffer's own pick for one item beats the
// manager's default for that item, which beats their general
// preferredVolumeUnit/preferredMassUnit, which beats the item's own unit.
//
// Own choice, no permission needed beyond being signed in — mirrors
// preferences GET/PUT in routes/settings.ts (requireAuth only). Not scoped
// by clientId: a user's personal pick for an item is theirs wherever they see
// that item, same as preferredVolumeUnit/preferredMassUnit today.
//
// Server-only, one-way (server -> device, overwrite) — same classification as
// ClientItemUnitDefault above; there is no offline write path for either.
model UserItemUnitPreference {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id])
  unit      String // one of PREFERENCE_UNITS in packages/core/src/units.ts
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, itemId])
}

model Supplier {
  id          String  @id @default(cuid())
  clientId    String
  client      Client  @relation(fields: [clientId], references: [id])
  name        String
  // Freeform legacy field — kept so existing notes aren't lost. The structured
  // fields below are what the Purchase report prints (client req 2026-07-20).
  contactInfo String?
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  // C.O.D. / 7 / 15 / 30 days / prepaid — see @fnb/core PAYMENT_TERMS.
  paymentTerms  String? // COD | NET_7 | NET_15 | NET_30 | PREPAID
  isActive    Boolean @default(true)

  purchases Purchase[]

  @@index([clientId])
}

model ItemAlias {
  id              String        @id @default(cuid())
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id])
  aliasNormalized String // lowercased, trimmed, single-spaced
  locationItemId  String?
  locationItem    LocationItem? @relation(fields: [locationItemId], references: [id])
  menuItemId      String?
  menuItem        MenuItem?     @relation(fields: [menuItemId], references: [id])
  source          String        @default("MANUAL") // MANUAL | IMPORT

  @@unique([clientId, aliasNormalized])
}

// ───────────────── Transactions (immutable once committed) ─────────────────
// Committed records are never edited. Corrections: void (reason) + linked
// replacement via correctionOfId. ActivityLog rows are written in the same
// $transaction as every mutation.

model CountSession {
  id            String    @id @default(cuid())
  locationId    String
  location      Location  @relation(fields: [locationId], references: [id])
  countDate     String // YYYY-MM-DD
  name          String?
  status        String    @default("OPEN") // OPEN | COMMITTED | VOID
  note          String?
  createdById   String
  createdByName String
  createdAt     DateTime  @default(now())
  // When the work actually happened on the device, as against createdAt = when
  // the server received it. An offline desktop that syncs a whole day at 9pm
  // would otherwise stamp every record 9pm, and the audit trail would claim a
  // 40-minute stock count took place in one second.
  //
  // Reconciliation is untouched by this either way — every report keys off the
  // business date (countDate/saleDate/purchaseDate/...), which is TEXT and has
  // always come from the user. This is for the audit trail and for ordering.
  //
  // Null on everything written through the browser, where the two are the same
  // instant. Read it as `occurredAt ?? createdAt`.
  occurredAt    DateTime?
  // Which source created this document: a registered desktop, or null for the
  // browser. Two jobs (docs/sync-and-data-lifecycle.md §7.2): while the document
  // is OPEN/DRAFT it is the OWNER — only that source may edit or commit it, which
  // removes the whole draft-merge problem instead of solving it. Afterwards it is
  // PROVENANCE, the thing an auditor needs when chasing a double-entered delivery.
  originDeviceId String?
  committedAt   DateTime?
  committedById String?
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?

  lines CountLine[]

  @@index([locationId, countDate])
}

model CountLine {
  id               String       @id @default(cuid())
  countSessionId   String
  countSession     CountSession @relation(fields: [countSessionId], references: [id])
  locationItemId   String
  locationItem     LocationItem @relation(fields: [locationItemId], references: [id])
  /// Which part of the establishment this tally came from. Null = the location
  /// does not split by area, or the line predates areas.
  ///
  /// Safe for the reconciliation by construction: report-assembly already SUMS
  /// count lines per item (`agg.beginFullQty += line.qtyFull`), so four area
  /// rows total exactly as one combined row did. Verified against both golden
  /// anchors.
  areaId           String?
  area             LocationArea? @relation(fields: [areaId], references: [id])
  countType        String // FULL | WEIGH
  qtyFull          Float        @default(0)
  scaleWeight      Float?
  scaleUnit        String? // g | oz
  tareWeight       Float?
  densityFactor    Float?
  remainingContent Float        @default(0) // WEIGH: computed content (ml or raw units)
  unitCost         Float        @default(0) // price snapshots at entry time
  unitRetail       Float        @default(0)
  status           String       @default("ACTIVE") // ACTIVE | VOID
  voidedAt         DateTime?
  voidedById       String?
  voidReason       String?
  correctionOfId   String?
  correctionOf     CountLine?   @relation("CountLineCorrection", fields: [correctionOfId], references: [id])
  corrections      CountLine[]  @relation("CountLineCorrection")
  createdById      String
  createdByName    String
  createdAt        DateTime     @default(now())
  occurredAt       DateTime? // device time — see CountSession.occurredAt

  @@index([countSessionId])
  @@index([locationItemId])
}

model Purchase {
  id            String    @id @default(cuid())
  locationId    String
  location      Location  @relation(fields: [locationId], references: [id])
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  refNo         String?
  purchaseDate  String // YYYY-MM-DD
  status        String    @default("DRAFT") // DRAFT | COMMITTED | VOID
  note          String?
  createdById   String
  createdByName String
  createdAt     DateTime  @default(now())
  occurredAt    DateTime? // device time — see CountSession.occurredAt
  // Which source created this document: a registered desktop, or null for the
  // browser. Two jobs (docs/sync-and-data-lifecycle.md §7.2): while the document
  // is OPEN/DRAFT it is the OWNER — only that source may edit or commit it, which
  // removes the whole draft-merge problem instead of solving it. Afterwards it is
  // PROVENANCE, the thing an auditor needs when chasing a double-entered delivery.
  originDeviceId String?
  committedAt   DateTime?
  committedById String?
  voidedAt      DateTime?
  voidedById    String?
  voidReason    String?

  lines PurchaseLine[]

  @@index([locationId, purchaseDate])
}

model PurchaseLine {
  id             String         @id @default(cuid())
  purchaseId     String
  purchase       Purchase       @relation(fields: [purchaseId], references: [id])
  locationItemId String
  locationItem   LocationItem   @relation(fields: [locationItemId], references: [id])
  qty            Float
  unitCost       Float
  lineTotal      Float
  status         String         @default("ACTIVE") // ACTIVE | VOID
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  correctionOfId String?
  correctionOf   PurchaseLine?  @relation("PurchaseLineCorrection", fields: [correctionOfId], references: [id])
  corrections    PurchaseLine[] @relation("PurchaseLineCorrection")
  createdById    String
  createdByName  String
  createdAt      DateTime       @default(now())
  occurredAt     DateTime? // device time — see CountSession.occurredAt

  @@index([purchaseId])
  @@index([locationItemId])
}

model SaleRecord {
  id              String         @id @default(cuid())
  locationId      String
  location        Location       @relation(fields: [locationId], references: [id])
  saleDate        String // YYYY-MM-DD
  kind            String // SALE | NON_REVENUE | PRODUCTION
  locationItemId  String? // XOR menuItemId
  locationItem    LocationItem?  @relation(fields: [locationItemId], references: [id])
  menuItemId      String?
  menuItem        MenuItem?      @relation(fields: [menuItemId], references: [id])
  recipeVersionId String? // snapshot of the version active at commit
  recipeVersion   RecipeVersion? @relation(fields: [recipeVersionId], references: [id])
  qty             Float
  unitPrice       Float          @default(0)
  discountPct     Float          @default(0)
  contentOverride Float? // legacy non_ml — NON_REVENUE only, per-unit content
  reason          String? // non-revenue reason
  note            String?
  source          String         @default("MANUAL") // MANUAL | IMPORT
  status          String         @default("ACTIVE") // ACTIVE | VOID
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?
  correctionOfId  String?
  correctionOf    SaleRecord?    @relation("SaleCorrection", fields: [correctionOfId], references: [id])
  corrections     SaleRecord[]   @relation("SaleCorrection")
  createdById     String
  createdByName   String
  createdAt       DateTime       @default(now())
  occurredAt      DateTime? // device time — see CountSession.occurredAt
  // Provenance only — a sale has no draft state to own. This is what answers
  // "was this delivery entered twice, once here and once on the bar PC?", the
  // one risk two-way sync cannot resolve for us (§7.4).
  originDeviceId  String?

  @@index([locationId, saleDate, kind])
  @@index([locationItemId])
}

model Forfeit {
  bottleKeep       BottleKeep?
  id               String       @id @default(cuid())
  locationId       String
  location         Location     @relation(fields: [locationId], references: [id])
  forfeitDate      String // YYYY-MM-DD
  locationItemId   String
  locationItem     LocationItem @relation(fields: [locationItemId], references: [id])
  scaleWeight      Float?
  scaleUnit        String?
  tareWeight       Float?
  densityFactor    Float?
  remainingContent Float        @default(0) // content re-entering stock (adds back into usage pool)
  qty              Float        @default(0) // count-item path
  note             String?
  status           String       @default("ACTIVE") // ACTIVE | VOID
  voidedAt         DateTime?
  voidedById       String?
  voidReason       String?
  correctionOfId   String?
  correctionOf     Forfeit?     @relation("ForfeitCorrection", fields: [correctionOfId], references: [id])
  corrections      Forfeit[]    @relation("ForfeitCorrection")
  createdById      String
  createdByName    String
  createdAt        DateTime     @default(now())
  occurredAt       DateTime? // device time — see CountSession.occurredAt
  originDeviceId   String? // provenance — see SaleRecord.originDeviceId

  @@index([locationId, forfeitDate])
}

// ───────────────────────── Inter-location transfers ─────────────────────────
// Linked two-location stock movement (client reqs #10/#13): the source
// dispatches (Trans Out), the destination confirms what actually arrived
// (Trans In). Sent vs received may differ — that gap is deliberate audit
// signal, surfaced by comparing the two locations' Transfer reports.
// Greenfield feature: no legacy PHP precedent — correctness rests on the
// hand-computed fixture in docs/golden-fixtures.md §2 (10 sent vs 8 received).
//
// Tenant guard: both locations MUST belong to the same client — enforced at
// create in routes/transfers.ts (the DB can't express it).
// Void ordering: a Transfer/TransferLine cannot be voided while an ACTIVE
// receipt line exists against it — the destination voids its receipt first,
// so both locations' books always move in cause→effect order.

model Transfer {
  id             String    @id @default(cuid())
  fromLocationId String
  fromLocation   Location  @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocationId   String
  toLocation     Location  @relation("TransferTo", fields: [toLocationId], references: [id])
  businessDate   String // YYYY-MM-DD — the day stock left the source
  status         String    @default("DRAFT") // DRAFT | COMMITTED | VOID
  note           String?
  createdById    String
  createdByName  String
  createdAt      DateTime  @default(now())
  occurredAt     DateTime? // device time — see CountSession.occurredAt
  // Which source created this document: a registered desktop, or null for the
  // browser. Two jobs (docs/sync-and-data-lifecycle.md §7.2): while the document
  // is OPEN/DRAFT it is the OWNER — only that source may edit or commit it, which
  // removes the whole draft-merge problem instead of solving it. Afterwards it is
  // PROVENANCE, the thing an auditor needs when chasing a double-entered delivery.
  originDeviceId String?
  committedAt    DateTime?
  committedById  String?
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?

  lines TransferLine[]

  @@index([fromLocationId, businessDate])
  @@index([toLocationId, businessDate])
}

model TransferLine {
  id             String         @id @default(cuid())
  transferId     String
  transfer       Transfer       @relation(fields: [transferId], references: [id])
  locationItemId String // the SOURCE location's catalog row
  locationItem   LocationItem   @relation(fields: [locationItemId], references: [id])
  qty            Float
  unitCost       Float // snapshot of the source LocationItem.cost at entry
  lineTotal      Float
  status         String         @default("ACTIVE") // ACTIVE | VOID
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  correctionOfId String?
  correctionOf   TransferLine?  @relation("TransferLineCorrection", fields: [correctionOfId], references: [id])
  corrections    TransferLine[] @relation("TransferLineCorrection")
  createdById    String
  createdByName  String
  createdAt      DateTime       @default(now())
  occurredAt     DateTime? // device time — see CountSession.occurredAt

  receipts TransferReceiptLine[]

  @@index([transferId])
  @@index([locationItemId])
}

// What the destination actually received against one dispatched line. At most
// one ACTIVE receipt per transfer line (app-enforced 409); a wrong entry is
// corrected the same way as every other leaf record — void + replacement
// linked via correctionOfId.
model TransferReceiptLine {
  id               String                @id @default(cuid())
  transferLineId   String
  transferLine     TransferLine          @relation(fields: [transferLineId], references: [id])
  toLocationItemId String // the DESTINATION location's catalog row
  toLocationItem   LocationItem          @relation(fields: [toLocationItemId], references: [id])
  qtyReceived      Float
  receiptDate      String // YYYY-MM-DD — the day stock arrived (may lag businessDate)
  note             String?
  status           String                @default("ACTIVE") // ACTIVE | VOID
  voidedAt         DateTime?
  voidedById       String?
  voidReason       String?
  correctionOfId   String?
  correctionOf     TransferReceiptLine?  @relation("TransferReceiptCorrection", fields: [correctionOfId], references: [id])
  corrections      TransferReceiptLine[] @relation("TransferReceiptCorrection")
  createdById      String
  createdByName    String
  createdAt        DateTime              @default(now())
  occurredAt       DateTime? // device time — see CountSession.occurredAt

  @@index([transferLineId])
  @@index([toLocationItemId])
  @@index([receiptDate])
}

// ───────────────────────── Menus & versioned recipes ─────────────────────────

model MenuItem {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  versions RecipeVersion[]
  sales    SaleRecord[]
  aliases  ItemAlias[]

  @@index([locationId])
}

model RecipeVersion {
  id            String   @id @default(cuid())
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])
  versionNo     Int
  srp           Float
  costAtPublish Float    @default(0)
  publishedAt   DateTime @default(now())
  publishedById String
  note          String?

  lines RecipeLine[]
  sales SaleRecord[]

  @@unique([menuItemId, versionNo])
}

model RecipeLine {
  id              String        @id @default(cuid())
  recipeVersionId String
  recipeVersion   RecipeVersion @relation(fields: [recipeVersionId], references: [id])
