{
  "name": "@fnb/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "LIS — offline inventory terminal",
  "author": "Liquor Inventory Solution",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build:server": "node build.mjs",
    "build": "npm run build:server && npm run build -w @fnb/web",
    "native": "node native.mjs",
    "dev": "npm run build:server && electron .",
    "verify:mirror": "node verify-mirror.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "dist": "npm run build && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.11.1",
    "exceljs": "^4.4.0",
    "pdfmake": "^0.2.23"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1"
  }
}
